<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
    <f:entry field="credentialsId" title="Asyntai API key">
        <c:select />
    </f:entry>
    <f:entry field="files" title="Files">
        <f:textarea default="${descriptor.defaultFiles}" />
    </f:entry>
    <f:entry field="titlePrefix" title="Title prefix">
        <f:textbox />
    </f:entry>
    <f:entry field="prune">
        <f:checkbox title="Delete entries whose file no longer exists" />
    </f:entry>
    <f:entry field="dryRun">
        <f:checkbox title="Dry run: report what would change and send nothing" />
    </f:entry>
    <f:advanced>
        <f:entry field="excludes" title="Exclude">
            <f:textarea />
        </f:entry>
        <f:entry field="rootDirectory" title="Root folder">
            <f:textbox />
        </f:entry>
        <f:entry field="websiteId" title="Website ID">
            <f:textbox />
        </f:entry>
        <f:entry field="apiUrl" title="API URL">
            <f:textbox default="${descriptor.defaultApiUrl}" />
        </f:entry>
    </f:advanced>
    <f:validateButton title="Test connection" progress="Testing..." method="testConnection"
                      with="credentialsId,apiUrl,websiteId" />
</j:jelly>
